cc_library {
    name: "libsmw_imx",
    vendor: true,
    srcs: [
        "./*.cpp",
        "psa/*.cpp",
    ],
    export_include_dirs: [
        "include"
    ],
    local_include_dirs: [
        "include"
    ],
    cflags: [
        "-Wall",
        "-Werror",
    ],

    shared_libs: [
        "liblog",
    ],
    static_libs: [
        "libsecureenclave",
    ],
}
