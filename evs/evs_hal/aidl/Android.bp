package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

cc_binary {
    name: "android.hardware.automotive.evs@EvsEnumeratorHw",
    defaults: ["android.hardware.graphics.common-ndk_static"],
    vendor: true,
    relative_install_path: "hw",
    overrides: ["evsmanagerd"],
    srcs: [
        ":libgui_frame_event_aidl",
        "src/*.cpp"
    ],
    shared_libs: [
        "android.hardware.graphics.bufferqueue@1.0",
        "android.hardware.graphics.bufferqueue@2.0",
        "android.hidl.token@1.0-utils",
        "libEGL",
        "libGLESv2",
        "libbase",
        "libbinder_ndk",
        "libbufferqueueconverter",
        "libcamera_metadata",
        "libhardware_legacy",
        "libhidlbase",
        "liblog",
        "libnativewindow",
        "libtinyxml2",
        "libui",
        "libutils",
        "libyuv",
    ],
    static_libs: [
        "android.frameworks.automotive.display-V2-ndk",
        "android.hardware.automotive.evs-V2-ndk",
        "android.hardware.common-V2-ndk",
        "libaidlcommonsupport",
        "libcutils",
    ],
    header_libs: [
        "libgui_aidl_headers",
    ],
    local_include_dirs: [
        "include"
    ],
    include_dirs: [
        "frameworks/native/include/",
        "vendor/nxp-opensource/imx/display/display",
    ],
    cflags: [
        "-DLOG_TAG=\"EvsDriver\"",
        "-DGL_GLEXT_PROTOTYPES",
        "-DEGL_EGLEXT_PROTOTYPES",
        "-Wall",
        "-Wextra",
        "-Werror",
        "-Wthread-safety",
    ],

    required: [
        "imx_evs_aidl_configuration.xml",
        "fake_evs_aidl_configuration.xml",
    ],
    vintf_fragments: [
        "android.hardware.automotive.evs@EvsEnumeratorHw.xml",
    ],
}

prebuilt_etc {
    name: "imx_evs_aidl_configuration.xml",
    soc_specific: true,
    src: "resources/imx_evs_configuration.xml",
    sub_dir: "automotive/evs",
}

prebuilt_etc {
    name: "fake_evs_aidl_configuration.xml",
    soc_specific: true,
    src: "resources/fake_evs_configuration.xml",
    sub_dir: "automotive/evs",
}
