package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

cc_binary {
    name: "imx_evs_app",
    defaults: [
        "android.hardware.graphics.common-ndk_shared",
        "vhalclient_defaults",
    ],
    local_include_dirs: ["inc"],
    srcs: ["src/*.cpp"],
    shared_libs: [
        "android.hardware.automotive.vehicle@2.0",
        "android.hardware.camera.device@3.2",
        "libEGL",
        "libGLESv2",
        "libbase",
        "libbinder",
        "libbinder_ndk",
        "libcamera_metadata",
        "evs-libcartelemetry-proto",
        "libcutils",
        "libhardware",
        "libpng",
        "libprotobuf-cpp-lite",
        "libui",
        "libutils",
        "libhidlbase",
    ],
    static_libs: [
        "android.frameworks.automotive.telemetry-V1-ndk",
        "android.hardware.automotive.evs-V2-ndk",
        "android.hardware.common-V2-ndk",
        "libaidlcommonsupport",
        "libmath",
        "libjsoncpp",
        "libvhalclient",
    ],
    required: [
        "ImxFakeCamConfig.json",
        "ImxCarFromTop.png",
        "ImxLabeledChecker.png",
        "dewarp_coords_ox03c20_1920x1280.bin",
    ],
    cflags: [
        "-DLOG_TAG=\"EvsApp\"",
        "-DGL_GLEXT_PROTOTYPES",
        "-DEGL_EGLEXT_PROTOTYPES",
        "-Wall",
        "-Werror",
        "-Wunused",
        "-Wunreachable-code",
    ],
}

cc_library {
    name: "evs-libcartelemetry-proto",
    srcs: [":cartelemetry-evs-proto-srcs"],
    proto: {
        export_proto_headers: true,
        type: "lite",
    },
    shared_libs: ["libprotobuf-cpp-lite"],
}

prebuilt_etc {
    name: "ImxCarFromTop.png",
    src: "res/ImxCarFromTop.png",
    sub_dir: "automotive/evs",
}

prebuilt_etc {
    name: "ImxLabeledChecker.png",
    src: "res/ImxLabeledChecker.png",
    sub_dir: "automotive/evs",
}

prebuilt_etc {
    name: "dewarp_coords_ox03c20_1920x1280.bin",
    src: "res/dewarp_coords_ox03c20_1920x1280.bin",
    sub_dir: "automotive/evs",
}

prebuilt_etc {
    name: "ImxFakeCamConfig.json",
    src: "res/ImxFakeCamConfig.json",
    sub_dir: "automotive/evs",
}
